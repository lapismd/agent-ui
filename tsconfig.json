{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "allowJs": true,
    "checkJs": false,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "types": ["svelte", "node", "vite/client"]
  },
  "include": [
    "packages/**/*.ts",
    "packages/**/*.svelte",
    "catalog/**/*.ts",
    "catalog/**/*.svelte",
    ".storybook/**/*.ts",
    "*.ts"
  ],
  "exclude": ["node_modules", "**/dist", "storybook-static"]
}
