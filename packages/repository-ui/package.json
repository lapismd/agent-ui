{
  "name": "@lapismd/repository-ui",
  "version": "0.1.0",
  "description": "Reusable controller-driven Git and JJ repository screens for LapisMD",
  "type": "module",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lapismd/agent-ui.git",
    "directory": "packages/repository-ui"
  },
  "homepage": "https://github.com/lapismd/agent-ui",
  "bugs": {
    "url": "https://github.com/lapismd/agent-ui/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE.md",
    "NOTICE.md",
    "!dist/**/*.test.*"
  ],
  "sideEffects": [
    "**/*.css"
  ],
  "svelte": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "svelte": "./dist/index.js",
      "import": "./dist/index.js"
    },
    "./styles.css": "./dist/styles.css",
    "./core": {
      "types": "./dist/core/index.d.ts",
      "svelte": "./dist/core/index.js",
      "import": "./dist/core/index.js"
    },
    "./stacks": {
      "types": "./dist/stacks/index.d.ts",
      "svelte": "./dist/stacks/index.js",
      "import": "./dist/stacks/index.js"
    },
    "./screens": {
      "types": "./dist/screens/index.d.ts",
      "svelte": "./dist/screens/index.js",
      "import": "./dist/screens/index.js"
    }
  },
  "scripts": {
    "build": "svelte-package -i src -o dist --tsconfig tsconfig.json && publint"
  },
  "dependencies": {
    "@lapismd/design-core": "^0.6.0",
    "@lucide/svelte": "^1.57.0"
  },
  "peerDependencies": {
    "svelte": "^5.0.0"
  }
}
