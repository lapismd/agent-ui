{
  "name": "@lapismd/repository-ui",
  "version": "0.1.0",
  "description": "Reusable controller-driven Git and JJ repository screens for LapisMD",
  "type": "module",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lapismd/agent-ui.git",
    "directory": "packages/repository-ui"
  },
  "homepage": "https://github.com/lapismd/agent-ui",
  "bugs": {
    "url": "https://github.com/lapismd/agent-ui/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE.md",
    "NOTICE.md",
    "!dist/**/*.test.*"
  ],
  "sideEffects": [
    "**/*.css"
  ],
  "svelte": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "svelte": "./dist/index.js",
      "import": "./dist/index.js"
    },
    "./styles.css": "./dist/styles.css",
    "./core": {
      "types": "./dist/core/index.d.ts",
      "svelte": "./dist/core/index.js",
      "import": "./dist/core/index.js"
    },
    "./stacks": {
      "types": "./dist/stacks/index.d.ts",
      "svelte": "./dist/stacks/index.js",
      "import": "./dist/stacks/index.js"
    },
    "./screens": {
      "types": "./dist/screens/index.d.ts",
      "svelte": "./dist/screens/index.js",
      "import": "./dist/screens/index.js"
    },
    "./jj": {
      "types": "./dist/jj/index.d.ts",
      "svelte": "./dist/jj/index.js",
      "import": "./dist/jj/index.js"
    },
    "./settings": {
      "types": "./dist/jj/settings/index.d.ts",
      "svelte": "./dist/jj/settings/index.js",
      "import": "./dist/jj/settings/index.js"
    },
    "./settings/styles.css": "./dist/jj/settings/styles.css",
    "./history": {
      "types": "./dist/history/index.d.ts",
      "import": "./dist/history/index.js"
    }
  },
  "scripts": {
    "build": "node ../../scripts/build-agent-package.mjs repository-ui"
  },
  "dependencies": {
    "@lapismd/design-core": "^0.7.1",
    "@lucide/svelte": "^1.57.0",
    "@tanstack/svelte-virtual": "^3.13.46",
    "@lapismd/jj-history": "^0.1.0",
    "@codemirror/autocomplete": "^6.20.4",
    "@codemirror/language": "^6.13.1",
    "@codemirror/state": "^6.7.6",
    "@codemirror/view": "^6.43.15",
    "@lezer/highlight": "^1.2.5"
  },
  "peerDependencies": {
    "svelte": "^5.0.0"
  }
}
