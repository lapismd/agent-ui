{
  "component": "AgentTranscript",
  "variables": [
    {
      "name": "--ui-transcript-max-width",
      "default": "62rem",
      "description": "Document column maximum width",
      "owner": "@lapismd/design-core",
      "source": "@lapismd/design-core/src/shared/chat/transcript/chat-body.css"
    },
    {
      "name": "--ui-transcript-font-size",
      "default": "0.875rem",
      "description": "Transcript text size",
      "owner": "@lapismd/design-core",
      "source": "@lapismd/design-core/src/shared/chat/transcript/chat-body.css"
    },
    {
      "name": "--ui-transcript-line-height",
      "default": "1.65",
      "description": "Transcript text rhythm",
      "owner": "@lapismd/design-core",
      "source": "@lapismd/design-core/src/shared/chat/transcript/chat-body.css"
    },
    {
      "name": "--ui-transcript-comment-font-size",
      "default": "var(--conversation-prose-size, var(--ui-transcript-font-size, 0.875rem))",
      "description": "Comment and review editor size",
      "owner": "@lapismd/design-core",
      "source": "@lapismd/design-core/src/shared/chat/transcript/comment-card.css"
    },
    {
      "name": "--ui-transcript-metadata-font-size",
      "default": "0.75rem",
      "description": "Timestamp and outcome text size",
      "owner": "@lapismd/design-core",
      "source": "@lapismd/design-core/src/shared/chat/transcript/chat-body.css"
    },
    {
      "name": "--ui-transcript-metadata-gap",
      "default": "0.4rem",
      "description": "Metadata item spacing",
      "owner": "@lapismd/design-core",
      "source": "@lapismd/design-core/src/shared/chat/transcript/chat-body.css"
    },
    {
      "name": "--ui-ai-chat-metadata-error-foreground",
      "default": "color-mix(in srgb, var(--destructive) 80%, var(--foreground))",
      "description": "Readable light error foreground; dark defaults to a 60% destructive mix",
      "owner": "@lapismd/design-core",
      "source": "@lapismd/design-core/src/shared/ai/chat.css"
    },
    {
      "name": "--ui-transcript-stale-gap",
      "default": "0.5rem",
      "description": "Spacing between retained unavailable-source comment cards",
      "owner": "@lapismd/design-core",
      "source": "@lapismd/design-core/src/shared/chat/transcript/chat-body.css"
    },
    {
      "name": "--ui-transcript-composer-trailing-space",
      "default": "4rem",
      "description": "Document writing space after the composer; 3rem below 600px. Classic keeps its existing inset.",
      "owner": "@lapismd/design-core",
      "source": "@lapismd/design-core/src/shared/chat/transcript/chat-body.css"
    },
    {
      "name": "--ui-reference-chip-radius",
      "default": "999px",
      "description": "Reference chip corners",
      "owner": "@lapismd/design-core",
      "source": "@lapismd/design-core/src/shared/shadcn/reference-chip/reference-chip.css"
    },
    {
      "name": "--ui-reference-chip-padding",
      "default": "0.12rem 0.4rem",
      "description": "Reference chip inset",
      "owner": "@lapismd/design-core",
      "source": "@lapismd/design-core/src/shared/shadcn/reference-chip/reference-chip.css"
    },
    {
      "name": "--ui-reference-chip-font-size",
      "default": "0.875em",
      "description": "Reference chip type size",
      "owner": "@lapismd/design-core",
      "source": "@lapismd/design-core/src/shared/shadcn/reference-chip/reference-chip.css"
    },
    {
      "name": "--ui-reference-chip-max-width",
      "default": "16rem",
      "description": "Reference label maximum width",
      "owner": "@lapismd/design-core",
      "source": "@lapismd/design-core/src/shared/shadcn/reference-chip/reference-chip.css"
    },
    {
      "name": "--ui-chat-inline-emoji-size",
      "default": "1.2em",
      "description": "Custom emoji diameter",
      "owner": "@lapismd/design-core",
      "source": "@lapismd/design-core/src/shared/chat/inline-reference/InlineReference.svelte"
    },
    {
      "name": "--ui-reference-mention-radius",
      "default": "calc(var(--radius) - 0.2rem)",
      "description": "Mention chip corners",
      "owner": "@lapismd/design-core",
      "source": "@lapismd/design-core/src/shared/shadcn/reference-chip/reference-chip.css"
    },
    {
      "name": "--ui-reference-mention-background",
      "default": "var(--secondary)",
      "description": "Mention fill",
      "owner": "@lapismd/design-core",
      "source": "@lapismd/design-core/src/shared/shadcn/reference-chip/reference-chip.css"
    },
    {
      "name": "--ui-reference-mention-padding",
      "default": "0 0.25em",
      "description": "Mention inset",
      "owner": "@lapismd/design-core",
      "source": "@lapismd/design-core/src/shared/shadcn/reference-chip/reference-chip.css"
    },
    {
      "name": "--ui-reference-mention-font-weight",
      "default": "600",
      "description": "Mention weight",
      "owner": "@lapismd/design-core",
      "source": "@lapismd/design-core/src/shared/shadcn/reference-chip/reference-chip.css"
    },
    {
      "name": "--ui-reference-mention-avatar-size",
      "default": "1.25em",
      "description": "Inline author avatar diameter",
      "owner": "@lapismd/design-core",
      "source": "@lapismd/design-core/src/shared/shadcn/reference-chip/reference-chip.css"
    }
  ]
}
