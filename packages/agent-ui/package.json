{
  "name": "@lapismd/agent-ui",
  "version": "0.1.0",
  "description": "Reusable controller-driven agent screens for LapisMD",
  "type": "module",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lapismd/agent-ui.git",
    "directory": "packages/agent-ui"
  },
  "homepage": "https://github.com/lapismd/agent-ui",
  "bugs": {
    "url": "https://github.com/lapismd/agent-ui/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE.md",
    "NOTICE.md",
    "!dist/**/*.test.*"
  ],
  "sideEffects": [
    "**/*.css"
  ],
  "svelte": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "svelte": "./dist/index.js",
      "import": "./dist/index.js"
    },
    "./styles.css": "./dist/styles.css",
    "./core": {
      "types": "./dist/core/index.d.ts",
      "svelte": "./dist/core/index.js",
      "import": "./dist/core/index.js"
    },
    "./chat": {
      "types": "./dist/chat/index.d.ts",
      "svelte": "./dist/chat/index.js",
      "import": "./dist/chat/index.js"
    },
    "./screens": {
      "types": "./dist/screens/index.d.ts",
      "svelte": "./dist/screens/index.js",
      "import": "./dist/screens/index.js"
    },
    "./sessions": {
      "types": "./dist/sessions/index.d.ts",
      "svelte": "./dist/sessions/index.js",
      "import": "./dist/sessions/index.js"
    }
  },
  "scripts": {
    "build": "node ../../scripts/build-agent-package.mjs"
  },
  "dependencies": {
    "@lapismd/design-core": "^0.7.4",
    "@lucide/svelte": "^1.57.0"
  },
  "peerDependencies": {
    "svelte": "^5.0.0"
  }
}
