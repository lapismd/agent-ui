    "build-storybook": "node scripts/validation.mjs run build-storybook",
    "spec:validate": "node scripts/validation.mjs run spec:validate",
    "spec:check": "node scripts/validation.mjs run spec:check",
    "spec:first": "node scripts/validation.mjs run spec:first",
    "spec:build": "node scripts/validation.mjs run spec:build",
    "format:check": "node scripts/validation.mjs run format:check",
    "check:source-layout": "node scripts/validation.mjs run check:source-layout",
    "check:catalog": "node scripts/validation.mjs run check:catalog",
    "test:browser": "node scripts/validation.mjs run test:browser",
    "storybook:check": "node scripts/validation.mjs run storybook:check",
    "checks": "node scripts/validation.mjs run checks",
    "check:validation-routing": "node scripts/validation.mjs run check:validation-routing",
