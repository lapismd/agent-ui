{
  "name": "@lapismd/agent-ui-workspace",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "license": "Apache-2.0",
  "packageManager": "pnpm@10.34.5",
  "scripts": {
    "build": "pnpm -r build",
    "check": "pnpm spec:validate && pnpm check:architecture && pnpm check:source-layout && svelte-check --tsconfig tsconfig.json --fail-on-warnings && pnpm format:check",
    "check:architecture": "node scripts/architecture.mjs",
    "test": "vitest run --project unit",
    "test:storybook": "node scripts/storybook-tests.mjs",
    "test:package": "node scripts/package-acceptance.mjs",
    "storybook": "WATCHPACK_POLLING=250 node scripts/with-storybook-env.mjs node scripts/storybook-run.mjs --no-open --host 127.0.0.1",
    "build-storybook": "pnpm build && storybook build --disable-telemetry && pnpm check:catalog",
    "spec:validate": "spec-validator validate",
    "spec:check": "spec-validator check",
    "spec:first": "spec-validator first",
    "spec:build": "spec-validator build",
    "spec:serve": "spec-validator serve",
    "format:check": "prettier --check .",
    "format": "prettier --write .",
    "changeset": "changeset",
    "storybook:stop": "node scripts/with-storybook-env.mjs bash scripts/storybook-stop.sh",
    "storybook:restart": "node scripts/with-storybook-env.mjs bash scripts/storybook-restart.sh",
    "test:source-parity": "playwright test --config tests/source-parity.config.ts",
    "check:source-layout": "node scripts/source-layout.mjs",
    "check:catalog": "node scripts/catalog-index-audit.mjs",
    "test:browser": "playwright test --config tests/catalog-browser.config.ts",
    "storybook:check": "pnpm test:storybook && pnpm test:browser && pnpm build-storybook",
    "checks": "pnpm check && pnpm test && pnpm storybook:check && pnpm test:package && pnpm spec:check"
  },
  "devDependencies": {
    "@changesets/cli": "^2.31.1",
    "@lapismd/design-core": "^0.6.0",
    "@lapismd/spec-validator": "^0.1.4",
    "@lucide/svelte": "^1.57.0",
    "@playwright/test": "1.61.1",
    "@storybook/addon-a11y": "10.5.7",
    "@storybook/addon-docs": "10.5.7",
    "@storybook/addon-themes": "10.5.7",
    "@storybook/addon-vitest": "10.5.7",
    "@storybook/icons": "^2.2.0",
    "@storybook/svelte-vite": "10.5.7",
    "@sveltejs/package": "^2.5.0",
    "@sveltejs/vite-plugin-svelte": "6.2.4",
    "@types/node": "^24.10.0",
    "@types/pngjs": "^6.0.5",
    "@types/react": "^19.3.0",
    "@vitest/browser-playwright": "4.1.11",
    "axe-core": "^4.13.0",
    "pngjs": "^7.0.0",
    "prettier": "^3.6.2",
    "prettier-plugin-svelte": "^3.5.2",
    "publint": "^0.3.12",
    "react": "19.2.7",
    "react-dom": "19.2.7",
    "remark-gfm": "^4.0.1",
    "storybook": "10.5.7",
    "svelte": "5.57.2",
    "svelte-check": "^4.3.1",
    "typescript": "~5.9.3",
    "vite": "7.3.2",
    "vitest": "4.1.11",
    "@lapismd/jj-history": "^0.1.0"
  }
}
