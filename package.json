    "storybook": "10.5.7",
    "svelte": "5.57.2",
    "svelte-check": "^4.3.1",
    "turbo": "^2.11.10",
    "typescript": "~5.9.3",
    "vite": "8.3.5",
    "vitest": "4.1.11"
